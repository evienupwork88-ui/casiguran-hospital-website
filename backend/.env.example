# Backend environment variables (Express API)
# Copy this file to .env and fill in real values for your machine.
# Never commit .env — it is already in .gitignore.
#
# NOTE: this file will be used starting when the backend app itself is
# scaffolded (a later increment). It is created now purely as a reference
# for which variables will eventually be needed, per the technical blueprint.

# Runtime
NODE_ENV=
PORT=
TIMEZONE=Asia/Manila
# Set to 1 only when exactly one trusted reverse proxy sits in front of this API (Hostinger proxy).
TRUST_PROXY_HOPS=0

# Supabase — used for Postgres + Storage only (no Supabase Auth, see docs/blueprint.md)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# One-time admin account seeding (npm run seed:admin) — see backend/db/README.md
# Not read by the running app, only by the seed script. Never commit real values.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
ADMIN_SEED_FIRST_NAME=
ADMIN_SEED_MIDDLE_NAME=
ADMIN_SEED_LAST_NAME=
ADMIN_SEED_NAME_EXTENSION=

# Sessions (bcrypt + custom Express-managed sessions)
SESSION_COOKIE_NAME=
SESSION_COOKIE_DOMAIN=
SESSION_SECRET=
SESSION_TTL_HOURS=

# CORS
CORS_ALLOWED_ORIGINS=

# Rate limiting (login endpoint)
RATE_LIMIT_LOGIN_MAX=
RATE_LIMIT_LOGIN_WINDOW_MINUTES=

# Gmail SMTP password-reset OTP delivery (use a Gmail App Password, never your account password)
GMAIL_SMTP_USER=
GMAIL_SMTP_APP_PASSWORD=
PASSWORD_RESET_EMAIL_FROM=

# File uploads
MAX_UPLOAD_IMAGE_MB=
MAX_UPLOAD_DOC_MB=
# Org chart images use a dedicated upload endpoint and default to 25 MB.
ORG_CHART_IMAGE_MAX_UPLOAD_MB=25
STORAGE_BUCKET_NAME=
APPROVAL_STAGING_BUCKET_NAME=cdh-approval-staging

# Logging
LOG_LEVEL=
