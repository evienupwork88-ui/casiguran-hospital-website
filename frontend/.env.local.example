# Frontend environment variables (Next.js)
# Copy this file to .env.local and fill in real values for your machine.
# Never commit .env.local — it is already in .gitignore.
#
# NOTE: this file will be used starting when the frontend app itself is
# scaffolded (a later increment). It is created now purely as a reference
# for which variables will eventually be needed, per the technical blueprint.

# Base URL the frontend uses to reach the backend API
NEXT_PUBLIC_API_BASE_URL=

# Display-only site name (not secret, just config)
NEXT_PUBLIC_SITE_NAME=
